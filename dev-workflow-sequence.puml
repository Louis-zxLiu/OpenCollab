@startuml
title OpenCollab Development Workflow Sequence

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam sequenceMessageAlign center

actor User
participant "CLI\nchat / team / eval" as CLI
participant "Team Orchestrator\nLead" as Team
participant "Lead Session" as LeadSession
participant "Lead Agent" as LeadAgent
participant "LLM Client" as LLM
participant "Coder Session" as CoderSession
participant "Reviewer Session" as ReviewerSession
participant "Tools\nbash / file_read / file_write / grep" as Tools
participant "Environment\nLocal / Worktree / Docker" as Env
participant "Workspace" as WS

== Entry ==
User -> CLI : submit coding task

alt Single-agent mode
  CLI -> LeadSession : create Session
  LeadSession -> LeadAgent : load prompt + tools + model
  LeadSession -> LLM : send messages + tool schemas
  LLM --> LeadSession : text or tool calls
  LeadSession -> Tools : execute requested tool
  Tools -> Env : run command / read / write
  Env -> WS : apply changes
  WS --> Env : files / stdout / stderr
  Env --> Tools : tool result
  Tools --> LeadSession : result text
  LeadSession -> LLM : continue loop
  LLM --> LeadSession : final answer
  LeadSession --> CLI : response
end

alt Team mode
  CLI -> Team : create Team
  Team -> LeadSession : create lead session
  LeadSession -> LeadAgent : load lead prompt + delegation tools
  LeadSession -> LLM : send task + tool schemas
  LLM --> LeadSession : delegate_task(analyst/coder) or delegate_with_review()

  alt Direct delegation
    LeadSession -> Team : delegate(role, task, context)
    Team -> CoderSession : create isolated session
    CoderSession -> LLM : execute subtask
    loop Explore / edit / verify
      LLM --> CoderSession : tool calls
      CoderSession -> Tools : dispatch tool
      Tools -> Env : execute in isolated env
      Env -> WS : read / write / test
      WS --> Env : results
      Env --> Tools : outputs
      Tools --> CoderSession : tool result
      CoderSession -> LLM : continue loop
    end
    LLM --> CoderSession : subtask summary
    CoderSession --> Team : summary + tokens used
    Team --> LeadSession : teammate summary
  end

  alt Delegation with review
    LeadSession -> Team : delegate_with_review(task)
    Team -> CoderSession : run coder implementation
    loop Coder loop
      CoderSession -> LLM : coding context
      LLM --> CoderSession : tool calls
      CoderSession -> Tools : dispatch tool
      Tools -> Env : execute
      Env -> WS : modify / test
      WS --> Env : result
      Env --> Tools : output
      Tools --> CoderSession : tool result
    end
    CoderSession --> Team : implementation summary

    Team -> ReviewerSession : run reviewer on result
    ReviewerSession -> LLM : review context
    LLM --> ReviewerSession : PASS or fix instructions
    ReviewerSession --> Team : review verdict

    alt PASS
      Team --> LeadSession : reviewed summary
    else Needs fixes
      Team -> CoderSession : retry with reviewer feedback
      note right of Team
        Max iterations controlled by
        delegate_with_review
      end note
      Team --> LeadSession : final success or failure summary
    end
  end

  LeadSession -> LLM : synthesize teammate results
  LLM --> LeadSession : final answer
  LeadSession --> CLI : response
end

== Evaluation mode ==
CLI -> Team : or Evaluator creates task runner
note right of CLI
eval mode reuses the same runtime,
but runs headlessly and collects
patches, token usage, steps, and traces
end note

CLI --> User : final summary

@enduml
