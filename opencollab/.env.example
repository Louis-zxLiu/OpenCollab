# OpenCollab Configuration
# Copy this file to .env and fill in your values.

# Default LLM model
OPENCOLLAB_MODEL=claude-sonnet-4-20250514

# LLM provider: "openai" or "anthropic"
OPENCOLLAB_PROVIDER=anthropic

# API key (or use provider-specific: OPENAI_API_KEY / ANTHROPIC_API_KEY)
# OPENCOLLAB_API_KEY=sk-...

# API base URL (for proxies or local models)
# OPENCOLLAB_BASE_URL=https://api.openai.com/v1

# Default token budget per session
# OPENCOLLAB_BUDGET=200000
