@startuml OpenCollab_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title OpenCollab - C4 Level 1 System Context

Person(developer, "Software Developer", "Uses OpenCollab to collaborate with AI agents on coding tasks.")
Person(evalOperator, "Evaluation Operator", "Runs headless benchmark and regression tasks.")

System(openCollab, "OpenCollab", "Minimal multi-agent software development framework with chat, team orchestration, tools, and evaluation harnesses.")

System_Ext(llmProviders, "LLM Provider APIs", "OpenAI, Anthropic, and OpenAI-compatible model providers.")
System_Ext(workspace, "Git Workspace / Repository", "Local repository, worktree, or mounted benchmark project that agents inspect and modify.")
System_Ext(mcpServers, "MCP Servers", "Optional Model Context Protocol servers that expose dynamic external tools over stdio JSON-RPC.")
System_Ext(dockerBench, "Docker / SWE-bench Environment", "Optional benchmark containers and Docker-based SWE-bench runner.")

Rel(developer, openCollab, "Runs chat/team workflows", "CLI / TUI")
Rel(evalOperator, openCollab, "Runs evaluation tasks", "JSONL task files")

Rel(openCollab, llmProviders, "Sends prompts, tool schemas, and conversation state; receives completions and tool calls", "HTTPS")
Rel(openCollab, workspace, "Reads files, writes patches, searches code, and executes commands", "Filesystem / shell")
Rel(openCollab, mcpServers, "Discovers and invokes optional external tools", "stdio JSON-RPC")
Rel(openCollab, dockerBench, "Runs benchmark tasks in isolated containers", "Docker CLI / API")
@enduml
