@startuml
title OpenCollab Architecture Around Core Modules

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle

skinparam component {
  BackgroundColor<<core>> #D6EAF8
  BackgroundColor<<state>> #FAD7A0
  BackgroundColor<<interface>> #D5F5E3
  BackgroundColor<<external>> #FCF3CF
  BackgroundColor<<risk>> #F5B7B1
  BorderColor #555555
}

package "Entry Layer" {
  [python -m opencollab] as PyMain <<external>>
  [CLI commands\nchat / team] as CLI <<external>>
  [Terminal TUI] as TUI <<risk>>
}

package "Application Layer" {
  [Chat Command Handler\n_chat()] as ChatApp <<core>>
  [Team Orchestrator\nTeam.run()/delegate()] as TeamApp <<core>>
  [Evaluation Harness\nrun_eval_task()] as EvalApp <<core>>
  [TUI Session Adapter\nTuiEventSink / TuiPermissionPolicy] as TuiAdapter <<risk>>
}

package "Core Layer" {
  [Session\nstateful facade] as Session <<core>>
  [Agent\nstateless config] as Agent <<core>>
  [Tool\nbase capability] as Tool <<core>>
  [Environment\nside-effect abstraction] as Env <<core>>

  [SessionRunner\nloop state machine] as Runner <<core>>
  [ToolCallProcessor\ndispatch + loop detection] as ToolProcessor <<core>>
  [ContextCompactor\nmessage summarization] as Compactor <<core>>
  [EventBus / SessionEvent] as EventBus <<core>>
  [SessionStore] as Store <<core>>
  [Tracer] as Tracer <<core>>

  [SessionState\nmessages / tokens / steps / phase / done / recent tool hashes] as State <<state>>
}

package "Interface Layer" {
  interface "LLM Boundary\ncomplete(messages, tools)" as ILLM <<interface>>
  interface "Tool Boundary\nTool.execute(params, env)" as ITool <<interface>>
  interface "Environment Boundary\nexec_cmd/read_file/write_file" as IEnv <<interface>>
  interface "Storage Boundary\nsave/load messages" as IStorage <<interface>>
  interface "Tracing Boundary\nlog_step()" as ITrace <<interface>>
  interface "Event Boundary\nEventSink/EventCallback.emit()" as IEvent <<interface>>
  interface "Permission Boundary\nPermissionPolicy.confirm()" as IPermission <<interface>>
}

package "External Adapter Layer" {
  [LLMClient\nOpenAI-compatible / Anthropic wrapper] as LLMClient <<external>>
  [Provider APIs\nOpenAI / Anthropic / compatible] as ProviderAPI <<external>>
  [Concrete Tools\nBash / FileRead / FileWrite / Grep / AskUser / MCP] as ConcreteTools <<external>>
  [Concrete Environments\nLocal / Worktree / Docker] as ConcreteEnv <<external>>
  [OS Process / Filesystem / Git / Docker] as SystemEffects <<external>>
  [Session JSONL files\n.opencollab/sessions] as SessionFiles <<external>>
  [Trace JSONL files\ntrajectories] as TraceFiles <<external>>
  [Rich Console Renderer] as Renderer <<risk>>
}

PyMain --> CLI : dispatch
CLI --> ChatApp : create / run chat
CLI --> TeamApp : create / run team
EvalApp --> Session : create / run

ChatApp --> Agent : create
ChatApp --> Env : create LocalEnvironment
ChatApp --> Session : create / load / run
ChatApp --> TUI : create / render
ChatApp --> TuiAdapter : wire event + permission

TeamApp --> Agent : create lead + teammate agents
TeamApp --> Session : create lead + teammate sessions
TeamApp --> Env : create Local/Worktree env
TeamApp --> Tool : expose delegate tools
TeamApp ..> EventBus : emit delegate events

Session *-- State : maintain state
Session --> Runner : delegate run_loop
Session --> ToolProcessor : build runtime
Session --> Compactor : build runtime
Session --> Store : persist / load
Session --> EventBus : emit event
Session --> Tracer : trace optional
Session --> ILLM : call model

Runner --> State : update phase / tokens / messages
Runner --> Agent : read model + temperature + tool schemas
Runner --> ILLM : call model
Runner --> ToolProcessor : execute tool calls
Runner --> Compactor : compact context
Runner --> EventBus : emit step/text events
Runner --> Tracer : log llm_call
Runner --> Store : auto-save

Agent --> Tool : owns allowed tools
Agent --> ITool : expose schemas / find tool

ToolProcessor --> State : append tool results / call hashes
ToolProcessor --> Agent : find tool
ToolProcessor --> ITool : execute tool
ToolProcessor --> EventBus : emit tool events
ToolProcessor --> Tracer : log tool_exec
ToolProcessor --> IPermission : confirm risky tool action

Tool --> IEnv : use environment
Env <|.. ConcreteEnv : implement
Tool <|.. ConcreteTools : implement

ILLM <|.. LLMClient : adapter
LLMClient --> ProviderAPI : call model

IEnv <|.. Env : contract
IEnv <|.. ConcreteEnv : concrete execution
ConcreteEnv --> SystemEffects : exec/read/write
ConcreteTools --> ConcreteEnv : execute through env
ConcreteTools --> SystemEffects : prompt / lock / MCP side effects

IStorage <|.. Store : adapter
Store --> SessionFiles : persist / load

ITrace <|.. Tracer : adapter
Tracer --> TraceFiles : persist trace

IEvent <|.. EventBus : dispatch
EventBus ..> TuiAdapter : emit event
TuiAdapter ..> TUI : render
TUI --> Renderer : render

IPermission <|.. TuiAdapter : confirm
TuiAdapter -[#red,dashed]-> TUI : UI/TUI coupling risk
TUI -[#red,dashed]-> EventBus : depends on SessionEvent shape
ConcreteTools -[#red,dashed]-> Renderer : AskUserTool prompts directly
TeamApp -[#red,dashed]-> EventBus : reuses SessionEvent for team lifecycle

@enduml
