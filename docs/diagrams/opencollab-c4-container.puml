@startuml OpenCollab_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title OpenCollab - C4 Level 2 Container Diagram

Person(developer, "Software Developer", "Uses interactive OpenCollab workflows.")
Person(evalOperator, "Evaluation Operator", "Runs headless benchmark tasks.")

System_Ext(llmProviders, "LLM Provider APIs", "OpenAI, Anthropic, and OpenAI-compatible providers.")
System_Ext(workspace, "Git Workspace / Repository", "Local repository, worktree, or mounted benchmark project.")
System_Ext(mcpServers, "MCP Servers", "Optional external tool servers over stdio JSON-RPC.")
System_Ext(dockerBench, "Docker / SWE-bench Environment", "Optional benchmark containers and Docker runner.")

System_Boundary(openCollab, "OpenCollab") {
  Container(cliTui, "CLI / TUI Frontend", "Python, Typer, Rich, prompt-toolkit", "Interactive chat and team command interface with terminal rendering.")
  Container(commandRouter, "Command Router", "Python CLI module", "Parses commands, loads configuration, constructs agents, and starts chat, team, or eval workflows.")

  Container(sessionCore, "Session Core", "Python async state machine", "Owns session lifecycle state, runs LLM loop, emits events, executes tools, compacts context, and autosaves.")
  Container(teamOrchestrator, "Team Orchestrator", "Python asyncio", "Coordinates lead and teammate agents with isolated contexts and optional worktrees.")
  Container(evalHarness, "Eval Harness", "Python asyncio", "Runs JSONL tasks headlessly, collects patches, metrics, and trajectories.")
  Container(toolLayer, "Tool Layer", "Python tools", "Bash, file read/write, grep, ask-user, and optional MCP-backed tools.")
  Container(llmClient, "LLM Client", "OpenAI SDK, Anthropic SDK", "Provider adapter for model completions and tool-calling responses.")

  ContainerDb(sessionStore, "Session Store", "JSONL files", "Messages-only session save/load and autosave files.")
  ContainerDb(traceStore, "Trace Store", "JSONL trajectory files", "LLM calls, tool executions, compaction, evaluation traces, and metrics.")
}

Rel(developer, cliTui, "Uses", "Terminal")
Rel(evalOperator, commandRouter, "Runs eval command", "CLI")

Rel(cliTui, commandRouter, "Submits commands and user prompts")
Rel(commandRouter, sessionCore, "Starts chat sessions")
Rel(commandRouter, teamOrchestrator, "Starts team workflows")
Rel(commandRouter, evalHarness, "Starts evaluation runs")

Rel(teamOrchestrator, sessionCore, "Creates lead and teammate sessions")
Rel(evalHarness, sessionCore, "Creates task sessions")

Rel(sessionCore, llmClient, "Requests completions and tool calls")
Rel(llmClient, llmProviders, "Calls provider APIs", "HTTPS")

Rel(sessionCore, toolLayer, "Executes tool calls")
Rel(toolLayer, workspace, "Reads, edits, searches, and executes commands", "Filesystem / shell")
Rel(toolLayer, mcpServers, "Invokes MCP tools", "stdio JSON-RPC")

Rel(sessionCore, sessionStore, "Persists messages-only session state")
Rel(sessionCore, traceStore, "Records execution traces")
Rel(evalHarness, dockerBench, "Runs optional SWE-bench jobs", "Docker CLI / API")
Rel(teamOrchestrator, workspace, "Creates isolated worktrees", "Git worktree")
@enduml
