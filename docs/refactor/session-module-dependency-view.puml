@startuml
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam ArrowColor #455A64

skinparam component {
  BorderColor #607D8B
  BackgroundColor #FFFFFF
  BackgroundColor<<facade>> #E3F2FD
  BorderColor<<facade>> #1976D2
  BackgroundColor<<coordinator>> #FFF3E0
  BorderColor<<coordinator>> #EF6C00
  BackgroundColor<<state-owner>> #E8F5E9
  BorderColor<<state-owner>> #2E7D32
  BackgroundColor<<domain-service>> #F3E5F5
  BorderColor<<domain-service>> #7B1FA2
  BackgroundColor<<event-boundary>> #E0F7FA
  BorderColor<<event-boundary>> #00838F
  BackgroundColor<<storage-boundary>> #ECEFF1
  BorderColor<<storage-boundary>> #546E7A
  BackgroundColor<<external>> #FAFAFA
  BorderColor<<external>> #9E9E9E
}

title opencollab.core.session - module dependency view

package "Public API" {
  [Session] <<facade>> as Session
}

package "Application Layer" {
  [SessionRunner] <<coordinator>> as Runner
}

package "Domain Layer" {
  [SessionState\nSessionPhase] <<state-owner>> as State
  [ToolCallProcessor] <<domain-service>> as Tools
  [ContextCompactor] <<domain-service>> as Compactor
}

package "Boundary Layer" {
  [EventBus\nSessionEvent] <<event-boundary>> as Events
  [SessionStore] <<storage-boundary>> as Store
  [LLMClient] <<external>> as LLM
}

Session *-- State : owns
Session --> Runner : delegates

Runner --> State : drives
Runner --> Tools : uses
Runner --> Compactor : uses
Runner --> Events : emits
Runner --> Store : persists
Runner --> LLM : calls

note right of State
Single source of truth for lifecycle state:
messages, tokens, step count, phase,
done status, and recent tool hashes.
end note

note bottom of Runner
Only the runner orchestrates state transitions:
precheck, LLM call, tool execution,
compaction, autosave, and terminal states.
end note

note bottom of Tools
Domain services should depend on minimal
inputs, not the full Session facade.
end note
@enduml
