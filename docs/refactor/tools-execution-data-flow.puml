@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #455A64
  LifeLineBorderColor #90A4AE
  LifeLineBackgroundColor #ECEFF1
  ParticipantBorderColor #607D8B
  ParticipantBackgroundColor #FFFFFF
  BoxBorderColor #B0BEC5
  BoxBackgroundColor #FAFAFA
}

title opencollab.tools - tool execution data flow

participant "ToolCallProcessor\n(session module)" as Processor
participant "Tool\n(base contract)" as Tool
participant "Concrete Tool\nbash/fs/human/mcp" as Concrete
participant "SandboxInterceptor\n(optional)" as Safety
participant "confirm_fn\n(optional)" as Confirm
participant "Environment\n(core.env)" as Env
participant "MCPConnection\n(optional)" as MCPConn
participant "External World\nfilesystem / shell / human / MCP server" as World

Processor -> Tool : execute(params, env, confirm_fn)
Tool -> Concrete : dynamic dispatch

alt BashTool
  Concrete -> Safety : check_cmd_interactive(command)
  Safety -> Confirm : ask if risky
  Confirm --> Safety : allow / deny
  Safety --> Concrete : ok or PermissionError
  Concrete -> Env : exec_cmd(command, timeout)
  Env -> World : run shell command
  World --> Env : stdout / stderr / exit code
  Env --> Concrete : ExecResult
  Concrete --> Processor : formatted string result

else FileReadTool / FileWriteTool
  Concrete -> Safety : check_path(path)
  Safety --> Concrete : safe absolute path
  Concrete -> Env : read_file() / write_file()
  Env -> World : filesystem operation
  World --> Env : file content / write result
  Env --> Concrete : data or error
  Concrete --> Processor : formatted string result

else GrepTool
  Concrete -> Env : exec_cmd(rg/grep)
  Env -> World : search workspace
  World --> Env : matches
  Env --> Concrete : stdout
  Concrete --> Processor : matches or no-match result

else AskUserTool
  Concrete -> Confirm : check interactive availability
  alt confirm_fn is absent
    Concrete --> Processor : non-interactive fallback text
  else confirm_fn is present
    Concrete -> World : prompt human directly
    World --> Concrete : answer / declined
    Concrete --> Processor : answer string
  end

else MCPTool
  Concrete -> MCPConn : call_tool(name, params)
  MCPConn -> World : JSON-RPC over stdio
  World --> MCPConn : MCP response
  MCPConn --> Concrete : result / error
  Concrete --> Processor : text or error string
end

note right of Processor
Session owns orchestration.
Tools return strings; session-level
ToolCallProcessor wraps them into
tool result messages.
end note

note right of Safety
Safety is optional at construction
time, but local filesystem/shell
tools are normally given one by CLI,
Team, and Eval callers.
end note

note over Concrete
Tool implementations should remain
thin adapters around Environment,
human input, or MCP servers.
end note
@enduml
