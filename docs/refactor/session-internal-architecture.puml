@startuml
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam ArrowColor #455A64

skinparam component {
  BorderColor #455A64
  BackgroundColor #FFFFFF
  BackgroundColor<<facade>> #E3F2FD
  BorderColor<<facade>> #1976D2
  BackgroundColor<<state-owner>> #E8F5E9
  BorderColor<<state-owner>> #2E7D32
  BackgroundColor<<coordinator>> #FFF3E0
  BorderColor<<coordinator>> #EF6C00
  BackgroundColor<<domain-service>> #F3E5F5
  BorderColor<<domain-service>> #7B1FA2
  BackgroundColor<<result>> #FFFDE7
  BorderColor<<result>> #F9A825
  BackgroundColor<<event>> #E0F7FA
  BorderColor<<event>> #00838F
  BackgroundColor<<storage>> #ECEFF1
  BorderColor<<storage>> #546E7A
  BackgroundColor<<compat>> #FAFAFA
  BorderColor<<compat>> #9E9E9E
}

title core/session internal module relationships

package "opencollab.core.session" {
  [__init__.py\nPublic exports + compatibility aliases] <<compat>> as Init

  [session.py\nSession] <<facade>> as Session
  [state.py\nSessionState + SessionPhase] <<state-owner>> as State
  [runner.py\nSessionRunner] <<coordinator>> as Runner
  [tools.py\nToolCallProcessor] <<domain-service>> as Tools
  [tools.py\nToolProcessingResult] <<result>> as ToolResult
  [compactor.py\nContextCompactor] <<domain-service>> as Compactor
  [compactor.py\nCompactResult] <<result>> as CompactResult
  [events.py\nEventBus + SessionEvent] <<event>> as Events
  [storage.py\nSessionStore] <<storage>> as Store
}

Init ..> Session : re-exports
Init ..> Runner : SessionMachine alias
Init ..> State : re-exports
Init ..> Tools : re-exports
Init ..> ToolResult : re-exports
Init ..> Compactor : re-exports
Init ..> CompactResult : re-exports
Init ..> Events : re-exports
Init ..> Store : re-exports

Session *-- State : owns lifecycle state
Session --> Runner : delegates run_loop()
Session --> Tools : constructs / wires
Session --> Compactor : constructs / wires
Session --> Events : constructs or accepts EventBus
Session --> Store : save/load/autosave

Runner --> State : transition writes via methods
Runner --> Tools : process tool calls
Runner --> Compactor : request compaction
Runner --> Events : step/text/error events
Runner --> Store : autosave callback via Session

Tools --> State : reads hash window
Tools --> Events : tool + loop events
Tools --> ToolResult : returns
ToolResult --> State : append messages + hash updates

Compactor --> State : reads messages
Compactor --> Events : compaction event
Compactor --> CompactResult : returns
CompactResult --> State : replace messages + token delta

Store --> State : persisted data is messages only

note right of State
Single source of truth for:
- messages
- used tokens
- step count
- done status
- phase
- recent tool hashes
end note

note bottom of Store
JSONL storage remains
messages-only.
Counters and runtime state
are not restored.
end note

note bottom of Events
SessionEvent(type, data)
protocol remains compatible.
end note
@enduml
