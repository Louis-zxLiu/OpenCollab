@startuml
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam ArrowColor #455A64

skinparam component {
  BorderColor #607D8B
  BackgroundColor #FFFFFF
  BackgroundColor<<contract>> #E3F2FD
  BorderColor<<contract>> #1976D2
  BackgroundColor<<tool>> #E8F5E9
  BorderColor<<tool>> #2E7D32
  BackgroundColor<<safety-boundary>> #FFF3E0
  BorderColor<<safety-boundary>> #EF6C00
  BackgroundColor<<mcp-boundary>> #F3E5F5
  BorderColor<<mcp-boundary>> #7B1FA2
  BackgroundColor<<port>> #ECEFF1
  BorderColor<<port>> #546E7A
  BackgroundColor<<external>> #FAFAFA
  BorderColor<<external>> #9E9E9E
}

title opencollab.tools - module dependency view

package "Tool Contract" {
  [Tool\nbase.py] <<contract>> as Tool
}

package "Local Tool Implementations" {
  [BashTool\nbash.py] <<tool>> as Bash
  [FileReadTool\nfs.py] <<tool>> as Read
  [FileWriteTool\nfs.py] <<tool>> as Write
  [GrepTool\nfs.py] <<tool>> as Grep
  [AskUserTool\nhuman.py] <<tool>> as Ask
}

package "Safety Boundary" {
  [SandboxInterceptor\nsafety.py] <<safety-boundary>> as Safety
}

package "MCP Boundary" {
  [load_mcp_tools()\nmcp.py] <<mcp-boundary>> as LoadMCP
  [MCPTool\nmcp.py] <<tool>> as MCPTool
  [MCPConnection\nmcp.py] <<mcp-boundary>> as MCPConn
}

package "Runtime Ports / External Dependencies" {
  [Environment\ncore.env] <<port>> as Env
  [confirm_fn\nhuman approval callback] <<port>> as Confirm
  [FileLock] <<external>> as FileLock
  [MCP Server Process\nstdio JSON-RPC] <<external>> as MCPServer
}

Bash -up-|> Tool
Read -up-|> Tool
Write -up-|> Tool
Grep -up-|> Tool
Ask -up-|> Tool
MCPTool -up-|> Tool

Bash --> Safety : checks command
Read --> Safety : checks path
Write --> Safety : checks path

Bash --> Env : exec_cmd()
Read --> Env : read_file()
Write --> Env : read/write_file()
Grep --> Env : exec_cmd(rg/grep)

Safety --> Confirm : asks for risky commands
Ask --> Confirm : detects interactive mode
Write --> FileLock : serializes writes

LoadMCP --> MCPConn : creates / initializes
LoadMCP --> MCPTool : discovers tools
MCPTool --> MCPConn : calls tools
MCPConn --> MCPServer : stdio JSON-RPC

note right of Tool
All tools expose:
- JSON Schema parameters
- to_openai_schema()
- async execute(params, env, confirm_fn)
end note

note bottom of Safety
Safety boundary owns path jail,
hard command blocks, and risky
command approval.
end note

note bottom of Env
Concrete tools operate through
Environment where possible,
keeping workspace execution
behind a port.
end note
@enduml
