@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #455A64
  LifeLineBorderColor #90A4AE
  LifeLineBackgroundColor #ECEFF1
  ParticipantBorderColor #607D8B
  ParticipantBackgroundColor #FFFFFF
  BoxBorderColor #B0BEC5
  BoxBackgroundColor #FAFAFA
}

title opencollab.core.session - run_loop iteration data flow

actor Caller
participant "Session\n<<facade>>" as Session
participant "SessionRunner\n<<coordinator>>" as Runner
participant "SessionState\n<<state-owner>>" as State
participant "ContextCompactor\n<<domain-service>>" as Compactor
participant "LLMClient\n<<external>>" as LLM
participant "ToolCallProcessor\n<<domain-service>>" as Tools
participant "EventBus\n<<event-boundary>>" as Events
participant "SessionStore\n<<storage-boundary>>" as Store

Caller -> Session : run_loop()
Session -> Runner : run_loop()

Runner -> State : read phase / done / budget / steps

alt context should compact
  Runner -> Compactor : compact(...)
  Compactor --> Runner : CompactResult DTO
  Runner -> State : apply compaction result
  Runner -> Events : emit compaction
end

Runner -> State : advance step / phase
Runner -> Events : emit step_start
Runner -> LLM : complete(messages, tools)
LLM --> Runner : assistant response + usage

Runner -> State : append assistant message\nadd token usage

alt response has tool calls
  Runner -> Tools : process(tool_calls)
  Tools --> Runner : ToolProcessingResult DTO
  Runner -> State : apply tool result
  Runner -> Events : emit tool events
  Runner -> Store : autosave
  Runner --> Session : continue loop
else final assistant response
  Runner -> Events : emit text_delta
  Runner -> State : mark done / phase DONE
  Runner -> Store : autosave
  Runner --> Session : final assistant content
end

Session --> Caller : result

note right of Runner
Runner is the orchestration point.
DTOs carry data back to Runner;
they do not mutate state independently.
end note

note right of State
All lifecycle updates are applied
through SessionState methods.
end note
@enduml
